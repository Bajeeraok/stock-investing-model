# Stock Investing Model - Web (dev with hot reload)
FROM node:20-alpine

WORKDIR /app

# Install dependencies first
COPY package.json package-lock.json* ./
RUN npm ci

# Copy rest (overwritten by mount, but needed for initial build)
COPY . .

EXPOSE 3001

# Next.js dev server has built-in hot reload
CMD ["npm", "run", "dev"]
